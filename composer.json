{
  "name": "b1tc0re/laravel-franken-cache",
  "description": "Laravel cache store adapter for FrankenPHP's tiered-cache API.",
  "keywords": [
    "frankenphp",
    "laravel",
    "cache",
    "tiered-cache"
  ],
  "homepage": "https://github.com/b1tc0re/laravel-franken-cache",
  "license": "MIT",
  "authors": [
    {
      "name": "Dmitry Chobanu",
      "email": "b1tc0re@yandex.ru"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/cache": "^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.16.1"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.2",
    "icanhazstring/composer-unused": "^0.9.6",
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^11.2",
    "phpunit/phpunit": "^13.0.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "b1tc0re\\LaravelFrankenCache\\ServiceProvider"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "b1tc0re\\LaravelFrankenCache\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "b1tc0re\\LaravelFrankenCache\\Test\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-update-cmd": [
      "bash admin/setup/setup.sh"
    ],
    "pint": "pint --parallel --max-processes=12 --ansi",
    "pint:check": "pint --test --ansi",
    "deduplicate:check": "phpcpd src/ tests/",
    "phpstan:check": "@php vendor/bin/phpstan analyse -vvv --memory-limit 2G -c phpstan.neon",
    "rector:check": "@php vendor/bin/rector process --dry-run",
    "audit:check": "composer audit --locked --abandoned=fail",
    "unused:check": "COMPOSER_UNUSED_ALLOW_XDEBUG=1 vendor/bin/composer-unused",
    "test": "@php -d zend.assertions=-1 vendor/bin/phpunit",
    "analyze": [
      "@phpstan:check",
      "@rector:check"
    ],
    "ci": [
      "Composer\\Config::disableProcessTimeout",
      "@pint:check",
      "@deduplicate:check",
      "@analyze",
      "@test"
    ]
  }
}
